# ─── Copy this file to .env and fill in your credentials ─────────────────────

# ── Required: AI keys ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ASSEMBLYAI_API_KEY=...

# ── LLM settings (optional overrides) ────────────────────────────────────────
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2

# ── YouTube (download OAuth client secrets JSON from Google Cloud Console) ────
# Path relative to project root:
YOUTUBE_CLIENT_SECRETS_PATH=config/yt_client_secrets.json
YOUTUBE_TOKEN_PATH=config/yt_token.json

# ── TikTok Direct Post API ────────────────────────────────────────────────────
TIKTOK_ACCESS_TOKEN=

# ── Instagram Graph API ───────────────────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# ── Pexels (free B-roll) ──────────────────────────────────────────────────────
PEXELS_API_KEY=

# ── Redis (for Celery) ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Pipeline behaviour ────────────────────────────────────────────────────────
AUTO_PUBLISH=false           # true → publish immediately; false → manual queue
MAX_CLIPS_PER_VIDEO=5
MIN_CLIP_VIRALITY_SCORE=7.0

# ── Caption style ─────────────────────────────────────────────────────────────
CAPTION_FONT=Impact
CAPTION_FONT_SIZE=72
CAPTION_BASE_COLOR=#FFFFFF
CAPTION_HIGHLIGHT_COLOR=#FFD700
CAPTION_NUMBER_COLOR=#00FF88
CAPTION_STROKE_COLOR=#000000
CAPTION_STROKE_WIDTH=4

# ── Video encoding ─────────────────────────────────────────────────────────────
OUTPUT_CRF=18
OUTPUT_FPS=30
